<?xml version="1.0" encoding="UTF-8"?>
<testdefinition version="1.0">
  <suite name="voicecall-cellbroadcast-tests" domain="mw">
    <description>Voicecall Cell Broadcast automatic tests</description>
    <set name="unit-tests" feature="Cell Broadcast">
      <description>Cell Broadcast service unit tests</description>
      <case manual="false" name="store">
        <step>/opt/tests/voicecall/cellbroadcast/tst_cellbroadcast</step>
      </case>
      <case manual="false" name="controller">
        <step>/opt/tests/voicecall/cellbroadcast/tst_cellbroadcastcontroller</step>
      </case>
    </set>
  </suite>
  <suite name="voicecall-manager-tests" domain="mw">
    <description>Voicecall manager automatic tests</description>
    <set name="unit-tests" feature="Voice Call Manager">
      <description>Call bookkeeping of the voice call manager</description>
      <case manual="false" name="manager">
        <step>/opt/tests/voicecall/manager/tst_voicecallmanager</step>
      </case>
      <case manual="false" name="ofono-provider">
        <step>/opt/tests/voicecall/ofono/tst_ofonoprovider</step>
      </case>
      <case manual="false" name="dbus-service">
        <step>/opt/tests/voicecall/dbus/tst_dbusservice</step>
      </case>
      <case manual="false" name="telepathy-dtmf">
        <step>/opt/tests/voicecall/telepathy/tst_dtmf</step>
      </case>
      <case manual="false" name="declarative-recordingfile">
        <step>/opt/tests/voicecall/declarative/tst_recordingfile</step>
      </case>
    </set>
  </suite>
</testdefinition>
